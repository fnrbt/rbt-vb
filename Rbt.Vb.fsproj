<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net10.0</TargetFrameworks>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Ast.fs" />
    <Compile Include="DateCore.fs" />
    <Compile Include="NumberText.fs" />
    <Compile Include="Lexer.fs" />
    <Compile Include="ParserSimple.fs" />
    <Compile Include="Validator.fs" />
    <Compile Include="Values.fs" />
    <Compile Include="ValueSemantics.fs" />
    <Compile Include="HostMembers.fs" />
    <Compile Include="Formatting.fs" />
    <Compile Include="Collections.fs" />
    <Compile Include="Builtins.fs" />
    <Compile Include="Bytecode.fs" />
    <Compile Include="BytecodeIO.fs" />
    <Compile Include="Compiler.fs" />
    <Compile Include="TypeCheck.fs" />
    <Compile Include="StackVm.fs" />
    <Compile Include="Api.fs" />
  </ItemGroup>

  <!-- Ship the F# sources under fable/ so Fable can compile this library from
       the NuGet package alone (for example in a Forge build sandbox). -->
  <ItemGroup>
    <Content Include="$(MSBuildProjectFullPath)" PackagePath="fable/" Pack="true" Visible="false" />
    <Content Include="@(Compile)" PackagePath="fable/%(RelativeDir)" Pack="true" Visible="false" />
  </ItemGroup>
</Project>
